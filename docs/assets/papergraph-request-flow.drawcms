  "assets": [],
  "motion": {
    "story": {
      "scenes": [
        {
          "id": "scene-1",
          "title": "PaperGraph: request to evidence-based reading",
          "steps": [
            {
              "id": "beat-1",
              "title": "Start with your request",
              "description": "The user names root papers and a reading goal. The MCP client or agent retains that authorization scope.",
              "targets": [
                {
                  "targetId": "request",
                  "targetKind": "node"
                },
                {
                  "targetId": "agent",
                  "targetKind": "node"
                },
                {
                  "targetId": "edge-request-agent-1",
                  "targetKind": "edge"
                }
              ]
            },
            {
              "id": "beat-2",
              "title": "Resolve a usable root source",
              "description": "Local LaTeX and local PDFs are supplied explicitly. arXiv input must be unambiguous. DOI discovery finds metadata and candidate public PDFs, without downloading; metadata is not body text.",
              "targets": [
                {
                  "targetId": "inputs",
                  "targetKind": "node"
                },
                {
                  "targetId": "gate",
                  "targetKind": "node"
                },
                {
                  "targetId": "edge-agent-inputs-1",
                  "targetKind": "edge"
                },
                {
                  "targetId": "edge-inputs-gate-1",
                  "targetKind": "edge"
                }
              ]
            },
            {
              "id": "beat-3",
              "title": "Ask when the source is unresolved",
              "description": "Conflicting arXiv identifiers or multiple eligible DOI candidates require a choice. If no usable public body is available, retry or supply a legally obtained local PDF.",
              "targets": [
                {
                  "targetId": "review",
                  "targetKind": "node"
                },
                {
                  "targetId": "edge-gate-review-1",
                  "targetKind": "edge"
                },
                {
                  "targetId": "edge-review-inputs-1",
                  "targetKind": "edge"
                }
              ]
            },
            {
              "id": "beat-4",
              "title": "Import into a local workspace",
