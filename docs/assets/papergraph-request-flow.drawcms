{
  "schemaVersion": 5,
  "meta": {
    "name": "PaperGraph: request to evidence-based reading",
    "diagramType": "flowchart"
  },
  "canvas": {},
  "nodes": [
    {
      "id": "request",
      "position": {
        "x": 0,
        "y": 0
      },
      "data": {
        "label": "Your paper + reading goal",
        "type": "terminator",
        "fillColor": "#EAF3FC",
        "strokeColor": "#5280AD",
        "textColor": "#18334D"
      },
      "type": "customShape",
      "style": {
        "width": 280,
        "height": 110
      }
    },
    {
      "id": "agent",
      "position": {
        "x": 400,
        "y": 0
      },
      "data": {
        "label": "MCP client / agent\nstdio; root-request scope",
        "type": "process",
        "fillColor": "#EAF3FC",
        "strokeColor": "#5280AD",
        "textColor": "#18334D"
      },
      "type": "customShape",
      "style": {
        "width": 280,
        "height": 110
      }
    },
    {
      "id": "inputs",
      "position": {
        "x": 800,
        "y": 0
      },
      "data": {
        "label": "PaperGraph source tools\nLocal TeX / arXiv / PDF / DOI\nMetadata is not full text",
        "type": "data",
        "fillColor": "#EAF3FC",
        "strokeColor": "#5280AD",
        "textColor": "#18334D"
      },
      "type": "customShape",
      "style": {
        "width": 280,
        "height": 110
      }
    },
    {
      "id": "gate",
      "position": {
        "x": 800,
        "y": 220
      },
      "data": {
        "label": "Root source ready?\nIdentity + usable body",
        "type": "decision",
        "fillColor": "#FFF7E8",
        "strokeColor": "#D19A43",
        "textColor": "#18334D"
      },
      "type": "customShape",
      "style": {
        "width": 280,
        "height": 150
      }
    },
    {
      "id": "review",
      "position": {
        "x": 1200,
        "y": 220
      },
      "data": {
        "label": "Choose or supply full text\nResolve ambiguity, retry\nor provide a legal local PDF",
        "type": "manual-input",
        "fillColor": "#FFF7E8",
        "strokeColor": "#D19A43",
        "textColor": "#18334D"
      },
      "type": "customShape",
      "style": {
        "width": 280,
        "height": 110
      }
    },
    {
      "id": "workspace",
      "position": {
        "x": 400,
        "y": 220
      },
      "data": {
        "label": "Local SQLite workspace\nImported body + provenance",
        "type": "database",
        "fillColor": "#EAF3FC",
        "strokeColor": "#5280AD",
        "textColor": "#18334D"
      },
      "type": "customShape",
      "style": {
        "width": 280,
        "height": 110
      }
    },
    {
      "id": "target",
      "position": {
        "x": 0,
        "y": 220
      },
      "data": {
        "label": "Paper Map\nChoose a result",
        "type": "process",
        "fillColor": "#EAF3FC",
        "strokeColor": "#5280AD",
        "textColor": "#18334D"
      },
      "type": "customShape",
      "style": {
        "width": 280,
        "height": 110
      }
    },
    {
      "id": "evidence",
      "position": {
        "x": 0,
        "y": 440
      },
      "data": {
        "label": "Inspect source evidence\nStatement / proof / citation",
        "type": "process",
        "fillColor": "#EAF3FC",
        "strokeColor": "#5280AD",
        "textColor": "#18334D"
      },
      "type": "customShape",
      "style": {
        "width": 280,
        "height": 110
      }
    },
    {
      "id": "dependencies",
      "position": {
        "x": 400,
        "y": 440
      },
      "data": {
        "label": "Local proof dependencies\nDirect / recursive\nEvidence-based reading order",
        "type": "process",
        "fillColor": "#EAF3FC",
        "strokeColor": "#5280AD",
        "textColor": "#18334D"
      },
      "type": "customShape",
      "style": {
        "width": 280,
        "height": 110
      }
    },
    {
      "id": "outputs",
